# ---- Free AI by default: OpenRouter (server-side only) ----
# Get a free key at https://openrouter.ai/keys. Free ":free" models cost nothing
# but have daily limits. Used whenever no Anthropic key is set.
OPENROUTER_API_KEY=
# Main model (tools + reads photos)
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# Cheap/fast model for the daily brief and monthly review
OPENROUTER_FAST_MODEL=nvidia/nemotron-nano-9b-v2:free

# ---- Limits for the shared key above (only applies when visitors use YOUR key) ----
# Requests per day: anonymous visitor (counted per IP), signed-in Google account, whole app.
SHARED_AI_PER_IP_DAILY=10
SHARED_AI_PER_USER_DAILY=40
SHARED_AI_DAILY_LIMIT=200
# Require Google sign-in before the shared key can be used (strongest abuse control)
SHARED_AI_REQUIRE_SIGNIN=false
# Sites allowed to use the shared key (defaults to the site itself). Comma separated.
ALLOWED_ORIGINS=
# Let the shared key use paid models too (default: free models only, so it can't cost money)
OPENROUTER_ALLOW_PAID=false

# ---- Claude (optional, paid, best quality; used instead of OpenRouter when set) ----
# Leave everything empty to run in "demo mode" (simple rule-based replies, no OCR).
# Users can also bring their own key in Settings → API keys; it takes priority over these.
ANTHROPIC_API_KEY=
# Main model for chat, OCR and summaries
ANTHROPIC_MODEL=claude-sonnet-5
# Cheaper/faster model for small jobs (monthly review, daily brief)
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# Requests per minute per IP for the AI routes
AI_RATE_LIMIT_PER_MIN=30

# ---- Speech-to-text (any OpenAI-compatible /audio/transcriptions endpoint) ----
# OpenAI: https://api.openai.com/v1  model whisper-1
# Groq:   https://api.groq.com/openai/v1  model whisper-large-v3-turbo
# Leave empty to use the browser's built-in live transcription instead.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ---- Search by meaning (optional) ----
# Voyage AI embeddings. Without a key, search uses keyword ranking (BM25).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# ---- Exchange rates for multi-currency (optional) ----
# Defaults to the free https://open.er-api.com/v6/latest feed (no key needed).
FX_API_URL=

# ---- Sync with Google Drive (optional, recommended) ----
# Users sign in with Google; data is stored in a private app folder in their own Drive.
# Setup steps: GUIDE.md -> "Sync with Google Drive".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: separate secret for encrypting the Google session cookie (defaults to the client secret)
GOOGLE_TOKEN_SECRET=
# Optional: only if the callback URL can't be detected (e.g. custom proxies)
GOOGLE_REDIRECT_URI=

# ---- Cloud sync + shared spaces with Supabase (optional) ----
# Create a Supabase project, run supabase/schema.sql, then fill these in.
# Leave empty to keep all data in the browser only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Service worker in development (optional) ----
# The offline/installable PWA is enabled automatically in production builds.
NEXT_PUBLIC_ENABLE_SW=
